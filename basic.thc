* this is a basic example of thcee (basic.thc) *
** multi line
comment **

irt 'importpackagename' fr 'package' nr ;

g def isthr::x:float {
    xval::bool = x eq 3 ; (xval = check x = 3) ;
    g mem xval ;
}

run {
    prt "number?" ;
    inp y ;

    if y !float {
        prt "not a float" ;
        ret ;
    }

    finalcheck = isthr(y) ;

    if finalcheck 1 {
        prt "True" ;
    } oth {
        prt "False" ;
    }

    def npmlist {
         ssh cmd [
            npm,
            "-g",
            "list"
         ],
    } ;

    prt "search for npm packages? " ;
    inp pack ;

    npmlist ;
    sto npmlist as "npm list.txt" ;
    grabbed = "npm list.txt" grep pack::str ;
    rem "npm list.txt" ;
    prt grabbed ;
)



